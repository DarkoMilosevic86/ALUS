# -- the Gestures page --

msgid "Commands and keys"
msgstr "Komande i tasteri"

msgid "Every command ALUS knows, with the keys bound to it. A command with no description is not shown, because a command that cannot be explained cannot be rebound sensibly."
msgstr "Svaka komanda koju ALUS zna, sa tasterima vezanim za nju. Komanda bez opisa se ne prikazuje, jer komanda koja se ne može objasniti ne može se ni razumno prevezati."

msgid "Edit gestures"
msgstr "Uredi gestove"

msgid "Tables"
msgstr "Tabele"

# -- commands that are not in this version (data/commands-status.ini) --
#
# Spoken instead of nothing when a key runs a command ALUS has not written
# yet. Short on purpose: the user knows which key they pressed, and what
# matters is that the key is not silent (FAZA6.md O10, FAZA9.md N99).

msgid "not in this version"
msgstr "nema u ovoj verziji"

# -- stopping ALUS from the keyboard (ALUS+q) --

msgid "exiting"
msgstr "izlazim"

# Spoken when `quit` is run from something that does not own the loop --
# alus-cli, or a test. Never silence: this is the one command a user cannot
# work around without finding a terminal (FAZA9.md N99).
msgid "cannot quit from here"
msgstr "odavde ne mogu da izađem"

# -- menjanje sinteze i glasa s tastature (alus+control+strelice) --
#
# Izgovara se kad prsten podešavanja sinteze nema šta da pomera: drajver ne
# prijavljuje ni jedno podešavanje koje se može menjati. Upstream ovde kaže
# "No settings", pa taj msgid dolazi iz njegovog kataloga; ovo ispod su
# poruke koje ALUS ima a upstream nema.

# Izgovara se kad komanda koja menja govor bude pokrenuta tamo gde govora
# nema -- `alus-daemon --no-speech`, alus-cli, dijagnostika.
msgid "speech is not available"
msgstr "govor nije dostupan"

# -- čuvanje i vraćanje podešavanja (alus+control+c, alus+control+r) --

# Upisivanje datoteke nije uspelo: home koji se ne može pisati, pun disk.
# Nikad tiho: korisnik koji veruje da je podešavanje sačuvano, a posle
# restarta ga nema, nema načina da zna koja od te dve stvari nije prošla.
msgid "Could not save configuration"
msgstr "Ne mogu da sačuvam podešavanja"

msgid "cannot save the configuration from here"
msgstr "odavde ne mogu da sačuvam podešavanja"

msgid "cannot revert the configuration from here"
msgstr "odavde ne mogu da vratim podešavanja"

# -- vreme i datum (alus+f12) --

# Izgovara se kad lokalizacija ne daje nijedan upotrebljiv format vremena.
# Nikad tišina: taster koji ne kaže ništa ne razlikuje se od tastera koji
# nije ni stigao.
msgid "cannot read the clock"
msgstr "ne mogu da pročitam sat"

# -- detalji na koje kontrola pokazuje (alus+d) --
#
# Upstream kaže "No additional details" kad relacije nema; ovo je drugi
# slučaj: relacija postoji, ali meta ne nosi tekst koji ALUS može da pročita.
# Dve različite činjenice, pa i dve poruke -- inače bi korisnik tražio
# relaciju koja je tu.
msgid "No details summary"
msgstr "Nema sažetka detalja"

# -- razvojne informacije o objektu (alus+f1) --
#
# Upstream otvara svoj prikazivač dnevnika; ALUS ga nema, pa jedino što ne
# sme da se izostavi jeste GDE je informacija otišla -- inače taster izgleda
# mrtav.
msgid "Developer info written to the log"
msgstr "Razvojne informacije su upisane u dnevnik"

# -- izlazak iz ugnežđenog dokumenta (alus+control+space) --

msgid "Not in a document"
msgstr "Nije u dokumentu"

msgid "No containing document"
msgstr "Nema dokumenta koji ga sadrži"

msgid "Could not move to the containing document"
msgstr "Ne mogu da pređem na dokument koji ga sadrži"

# -- ponavljanje poslednje izgovorenog (alus+x) --
#
# Upstream se ovde tiho vraća. ALUS ne: taster koji ne odgovori ništa ne
# razlikuje se od tastera koji nije stigao (FAZA9.md N99).
msgid "Nothing to repeat"
msgstr "Nema šta da se ponovi"

# Blizanac poruke za sistemski kursor ("Unable to determine the caret
# position"), koju upstream ima; ovu, za pregledni kursor, nema.
msgid "Unable to determine the review cursor position"
msgstr "Ne mogu da utvrdim poziciju preglednog kursora"

# -- izbor glasa i modula u prozoru podešavanja --
#
# Ova dva reda su bila polja za slobodan tekst: trebalo je upisati tačno ime
# glasa, a prazno polje se upisivalo kao `voice=\s` (FAZA10.md N107). Sada su
# liste onoga što speech-dispatcher stvarno nudi.

msgid "The speech-dispatcher module. Takes effect when ALUS restarts its speech, which happens on the next configuration reset."
msgstr "Modul speech-dispatcher-a. Primenjuje se kad ALUS ponovo pokrene govor, što se dešava pri sledećem vraćanju podešavanja."

msgid "The voices of the output module above. After changing the module, close and reopen this window to see its voices."
msgstr "Glasovi izlaznog modula iznad. Posle promene modula zatvorite i ponovo otvorite ovaj prozor da biste videli njegove glasove."

# Glas ili modul koji podešavanja navode, a sintetizator ga ne nudi -- u
# međuvremenu deinstaliran, ili nikad ispravan. Mora da se VIDI u prozoru,
# inače korisnik ne zna šta treba da zameni. %s je ime, pod navodnicima.
msgid "%s (not offered by the synthesizer)"
msgstr "%s (sintetizator ga ne nudi)"

# -- podešavanja se primenjuju kad se prozor zatvori --
#
# Ranije je svaka promena odmah upisivala fajl, a ALUS je na svaki upis radio
# pun restart podsistema (govor, tastatura, objektni model), pa je govor
# ćutao i sekao se dok je korisnik bio u prozoru. Sada je jedan upis, pri
# zatvaranju.

msgid "Takes effect when you press OK; ALUS does not need to be restarted."
msgstr "Primenjuje se kad pritisnete U redu; ALUS ne treba ponovo pokretati."

msgid "The speech-dispatcher module. Choosing one shows its voices below; nothing changes until you press OK."
msgstr "Modul speech-dispatcher-a. Izbor modula odmah prikazuje njegove glasove ispod; ništa se ne menja dok ne pritisnete U redu."

msgid "The voices of the output module above. The new voice is heard when you press OK."
msgstr "Glasovi izlaznog modula iznad. Novi glas se čuje kad pritisnete U redu."

# N125: U redu čuva izmene; Otkaži, Escape i dugme u zaglavlju ih odbacuju.
msgid "OK"
msgstr "U redu"

msgid "Applies the changed settings and closes the window"
msgstr "Primenjuje izmenjena podešavanja i zatvara prozor"

msgid "Closes the window without changing anything"
msgstr "Zatvara prozor bez ikakvih izmena"

# N126: glas i varijanta odvojeno, izlazni modul u prstenu, dugme Probaj.
msgid "This is how this voice sounds."
msgstr "Ovako zvuči ovaj glas."

msgid "Variant"
msgstr "Varijanta"

msgid "The variant of the voice above."
msgstr "Varijanta glasa iznad."

msgid "No variant"
msgstr "Bez varijante"

msgid "Try the voice"
msgstr "Probaj glas"

msgid "Says a sentence with the module, voice and variant above, without changing the screen reader's voice."
msgstr "Izgovara rečenicu modulom, glasom i varijantom iznad, a da se glas čitača ekrana ne promeni."

msgid "Try"
msgstr "Probaj"

