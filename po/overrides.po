#
# ALUS Serbian translations that upstream does not have.
#
# WRITTEN IN SERBIAN LATIN, by hand, and the ONLY file in po/ that is. The two
# shipped catalogues are generated from it and from upstream's own Serbian:
#
#   tools/import-nvda-po.py   ->   po/sr.po        (transliterated to Cyrillic)
#                             ->   po/sr@latin.po  (this text verbatim)
#
# so every string here is translated once and is correct in both scripts. The
# transliteration is strict and leaves placeholders, product names and format
# names alone (see to_cyrillic in the importer).
#
# What lands here, and nothing else:
#   * messages ALUS has and upstream does not,
#   * messages whose English ALUS spells differently -- almost always because
#     upstream formats with {named} placeholders and ALUS uses one %s
#     (FAZA9.md O3),
#   * the braille abbreviations, which are cell counts rather than words and
#     have to be chosen for Serbian rather than transliterated.
msgid ""
msgstr ""
"Project-Id-Version: alus 2026.1.0\n"
"Language: sr_RS@latin\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

# ---------------------------------------------------------------------------
# Plurals. Serbian has three forms and English two, which is the whole reason
# these are P_() in the source: form 0 is 1/21/31, form 1 is 2-4, form 2 is
# everything else including 5-20 and 0.
# ---------------------------------------------------------------------------

msgid "%s row"
msgid_plural "%s rows"
msgstr[0] "%s red"
msgstr[1] "%s reda"
msgstr[2] "%s redova"

msgid "%s character"
msgid_plural "%s characters"
msgstr[0] "%s znak"
msgstr[1] "%s znaka"
msgstr[2] "%s znakova"

