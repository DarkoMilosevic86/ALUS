#: src/i18n/data_strings.cpp:228
msgid "Reports the current navigator object. Pressing twice spells this information, and pressing three times Copies name and value of this object to the clipboard"
msgstr "Prijavljuje trenutni navigacioni objekat. Ako pritisnete dva puta sriče informaciju, ako pritisnete tri puta kopira ime i vrednost ovog objekta u privremenu memoriju"

#: src/i18n/data_strings.cpp:229
msgid "Reports information about the location of the text or object at the review cursor. Pressing twice may provide further detail."
msgstr "Daje informacije o lokaciji teksta ili objekta na poziciji preglednog kursora. Ako pritisnete dva puta može pružiti više detalja."

#: src/i18n/data_strings.cpp:230
msgid "Logs information about the current navigator object which is useful to developers and activates the log viewer so the information can be examined."
msgstr "Evidentira informacije o trenutnom navigacionom objektu koje su korisne programerima i aktivira pregled dnevnika kako biste ih istražili."

#: src/i18n/data_strings.cpp:231
msgid "Moves the navigator object to the first object inside it"
msgstr "Pomera navigacioni objekat na prvi objekat unutar njega"

#: src/i18n/data_strings.cpp:232
msgid "Pressed once sets the keyboard focus to the navigator object, pressed twice sets the system caret to the position of the review cursor"
msgstr "Ako se pritisne jednom postavlja fokus tastature na navigacioni objekat, ako se pritisne dvaput postavlja sistemski kursor na pregledni kursor"

#: src/i18n/data_strings.cpp:233
msgid "Moves the navigator object to the next object"
msgstr "Pomera navigacioni objekat na naredni objekat"

#: src/i18n/data_strings.cpp:234
msgid "Moves to the next object in a flattened view of the object navigation hierarchy"
msgstr "Prelazi na sledeći objekat u ravnom prikazu  hierarhije navigacionih objekata"

#: src/i18n/data_strings.cpp:235
msgid "Moves the navigator object to the object containing it"
msgstr "Premešta navigacioni objekat u objekat koji ga sadrži"

#: src/i18n/data_strings.cpp:236
msgid "Moves the navigator object to the previous object"
msgstr "Pomera navigacioni objekat na prethodni objekat"

#: src/i18n/data_strings.cpp:237
msgid "Moves to the previous object in a flattened view of the object navigation hierarchy"
msgstr "Prelazi na prethodni objekat u ravnom prikazu hierarhije navigacionih objekata"

#: src/i18n/data_strings.cpp:238
msgid "Sets the navigator object to the current focus, and the review cursor to the position of the caret inside it, if possible."
msgstr "Postavlja navigacioni objekat na trenutni fokus, i pregledni kursor na poziciju sistemskog kursora unutar njega, ako je moguće."

#: src/i18n/data_strings.cpp:239
msgid "Moves to the next available setting in the synth settings ring"
msgstr "Premešta se na naredno dostupno podešavanje u krugu podešavanja govora"

#: src/i18n/data_strings.cpp:240
msgid "Opens ALUS configuration directory for the current user."
msgstr "Otvara folder sa ALUS podešavanjima za trenutnog korisnika."

#: src/i18n/data_strings.cpp:241
msgid "The next key that is pressed will not be handled at all by ALUS, it will be passed directly through to the application."
msgstr "ALUS neće obraditi sledeći pritisnuti taster, nego će ga proslediti direktno aplikaciji."

#: src/i18n/data_strings.cpp:242
msgid "Moves to the previous available setting in the synth settings ring"
msgstr "Premešta se na prethodno dostupno podešavanje u krugu podešavanja govora"

#: src/i18n/data_strings.cpp:243
msgid "Quits ALUS!"
msgstr "Zatvara ALUS!"

#: src/i18n/data_strings.cpp:244
msgid "Reads the current application status bar."
msgstr "Čita statusnu traku trenutne aplikacije."

#: src/i18n/data_strings.cpp:245
msgid "Reloads app modules and global plugins without restarting ALUS, which can be Useful for developers"
msgstr "Ponovno učitava module aplikacije i globalne dodatke bez ponovnog pokretanja ALUS-a, što može biti korisno programerima"

#: src/i18n/data_strings.cpp:246
msgid "Repeat the last spoken information. Pressing twice shows it in a browsable message."
msgstr "Ponavlja poslednju izgovorenu informaciju. Ako se pritisne dva puta informacija će biti prikazana u poruci režima pretraživanja."

#: src/i18n/data_strings.cpp:247
msgid "Reports the name of the current ALUS configuration profile"
msgstr "Prijavljuje ime trenutnog profila podešavanja"

#: src/i18n/data_strings.cpp:248
msgid "Speaks the filename of the active application along with the name of the currently loaded appModule"
msgstr "Izgovara ime datoteke aktivne aplikacije zajedno sa imenom trenutno učitanog modula"

#: src/i18n/data_strings.cpp:249
msgid "Reports the language for the text under the caret. If pressed twice, presents the information in browse mode"
msgstr "Najavljuje jezik teksta pod karetom. Dvostruki pritisak prikazuje tu informaciju u režimu pregleda"

#: src/i18n/data_strings.cpp:250
msgid "Reports information about the location of the text at the caret, or location of the currently focused object if there is no caret."
msgstr "Prijavljuje informacije o lokaciji teksta na poziciji kursora, ili lokaciji fokusiranog objekta ako nema kursora."

#: src/i18n/data_strings.cpp:251
msgid "Reports the text on the system clipboard. Pressing twice spells this information. Pressing three times spells it using character descriptions."
msgstr "Najavljuje tekst iz sistemske ostave. Dvostruki pritisak sriče tu informaciju. Trostruki pritisak je sriče opisima znakova."

#: src/i18n/data_strings.cpp:252
msgid "Reports the object with focus. If pressed twice, spells the information. Pressing three times spells it using character descriptions."
msgstr "Prijavljuje fokusirani objekat. Ako se pritisne dva puta, informacija se sriče. Ako se pritisne tri puta sriče se uz opise znakova."

#: src/i18n/data_strings.cpp:253
msgid "Reports the current line under the application cursor. Pressing this key twice will spell the current line. Pressing three times will spell the line using character descriptions."
msgstr "Prijavljuje trenutni red ispod kursora  aplikacije. Ako se pritisne dva puta, sriče trenutni red. Ako se pritisne tri puta, sriče trenutni red koristeći opise znakova."

#: src/i18n/data_strings.cpp:254
msgid "Reports information about the location of the current navigator object."
msgstr "Prijavljuje informacije o lokaciji trenutnog navigacionog objekta."

#: src/i18n/data_strings.cpp:255
msgid "Announces the current selection in edit controls and documents. Pressing twice spells this information. Pressing three times spells it using character descriptions. Pressing four times shows it in a browsable message."
msgstr "Najavljuje trenutnu selekciju u poljima za unos i dokumentima. Dvostruki pritisak sriče tu informaciju. Trostruki pritisak je sriče opisima znakova. Četvorostruki pritisak je prikazuje u poruci koja se može pregledati."

#: src/i18n/data_strings.cpp:256
msgid "Report summary of any annotation details at the system caret."
msgstr "Prijavljuje kratak opis svih detalja i napomena na poziciji sistemskog kursora."

#: src/i18n/data_strings.cpp:257
msgid "Reports the shortcut key of the currently focused object"
msgstr "Prijavljuje tastersku prečicu trenutno fokusiranog objekta"

#: src/i18n/data_strings.cpp:258
msgid "Reports information about the location of the currently focused object."
msgstr "Prijavljuje informacije o lokaciji trenutno fokusiranog objekta."

#: src/i18n/data_strings.cpp:259
msgid "Reports formatting info for the current review cursor position. If pressed twice, presents the information in browse mode"
msgstr "Prijavljuje informacije o formatiranju za trenutnu poziciju preglednog kursora. Ako se pritisne dva puta, prikazuje informacije u režimu pretraživanja"

#: src/i18n/data_strings.cpp:260
msgid "Reports formatting info for the text under the caret."
msgstr "Prijavljuje informacije o formatiranju    teksta na poziciji kursora."

#: src/i18n/data_strings.cpp:261
msgid "Reports formatting info for the current review cursor position."
msgstr "Prijavljuje informacije o formatiranju  na poziciji preglednog kursora."

#: src/i18n/data_strings.cpp:262
msgid "Report the destination URL of the link at the position of caret or focus. If pressed twice, shows the URL in a window for easier review."
msgstr "Prijavljuje odredišnu adresu linka na poziciji kursora ili fokusa. Ako se pritisne dva puta, prikazuje adresu u prozoru radi lakšeg pregleda."

#: src/i18n/data_strings.cpp:263
msgid "Displays the destination URL of the link at the position of caret or focus in a window, instead of just speaking it. May be preferred by braille users."
msgstr "Prikazuje odredišnu adresu linka na poziciji kursora ili fokusa u prozoru, umesto da je samo izgovori. Može više odgovarati korisnicima brajevih redova."

#: src/i18n/data_strings.cpp:264
msgid "Reports formatting info for the text under the caret. If pressed twice, presents the information in browse mode"
msgstr "Prijavljuje informacije o formatiranju teksta na trenutnoj poziciji kursora. Ako se pritisne dva puta, prikazuje informacije u režimu pretraživanja"

#: src/i18n/data_strings.cpp:265
msgid "Reports information about the location of the text at the review cursor, or location of the navigator object if there is no text under review cursor."
msgstr "Prijavljuje informacije o lokaciji teksta preglednog kursora, ili lokaciji navigacionog objekta ako nema teksta na poziciji preglednog kursora."

#: src/i18n/data_strings.cpp:266
msgid "Reads the current application status bar. If pressed twice, spells the information. If pressed three times, copies the status bar to the clipboard"
msgstr "Čita statusnu traku trenutne aplikacije. Ako se pritisne dva puta, sriče informaciju. Ako se pritisne tri puta, kopira statusnu traku u privremenu memoriju"

#: src/i18n/data_strings.cpp:267
msgid "Restarts ALUS!"
msgstr "Ponovo pokreće ALUS!"

#: src/i18n/data_strings.cpp:268
msgid "Pressing once reverts the current configuration to the most recently saved state. Pressing three times resets to factory defaults."
msgstr "Ako se pritisne jednom vraća trenutna podešavanja na poslednje sačuvano stanje. Ako se pritisne tri puta vraća na fabrička podešavanja."

#: src/i18n/data_strings.cpp:269
msgid "Reads the current application status bar and moves navigator object into it."
msgstr "Čita trenutnu statusnu traku aplikacije i  prebacuje navigacioni objekat na nju."

#: src/i18n/data_strings.cpp:270
msgid "Switches to the next review mode (e.g. object, document or screen) and positions the review position at the point of the navigator object"
msgstr "Prelazi na naredni režim pregleda (na primer objekat, dokument ili ekran) i postavlja lokaciju za pregled na mesto navigacionog objekta"

#: src/i18n/data_strings.cpp:271
msgid "Switches to the previous review mode (e.g. object, document or screen) and positions the review position at the point of the navigator object"
msgstr "Prelazi na prethodni režim pregleda (na primer objekat, dokument ili ekran) i postavlja lokaciju za pregled na mesto navigacionog objekta"

#: src/i18n/data_strings.cpp:272
msgid "Performs the default action on the current navigator object (example: presses it if it is a button)."
msgstr "Izvršava podrazumevanu radnju na trenutnom navigacionom objektu (na primer: ako je dugme pritiska ga)."

#: src/i18n/data_strings.cpp:273
msgid "Moves the review cursor to the bottom line of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor u poslednji red trenutnog navigacionog objekta i izgovara ga"

#: src/i18n/data_strings.cpp:274
msgid "If pressed once, the text from the previously set start marker up to and including the current position of the review cursor is selected. If pressed twice, the text is copied to the clipboard"
msgstr "Ako se pritisne jednom , tekst od prethodno postavljenog početnog markera uključujući trenutnu poziciju Preglednog kursora će biti izabran. Ako se pritisne dva puta , tekst će biti kopiran u privremenu memoriju"

#: src/i18n/data_strings.cpp:275
msgid "Reports the character of the current navigator object where the review cursor is situated. Pressing twice reports a description or example of that character. Pressing three times reports the numeric value of the character in decimal and hexadecimal"
msgstr "Prijavljuje znak trenutnog navigacionog objekta gde se nalazi pregledni kursor. Ako se pritisne dva puta, prijavljuje opis ili primer tog znaka. Ako se pritisne tri puta prijavljuje brojčanu vrednost znaka u decimalnom ili heksadecimalnom zapisu"

#: src/i18n/data_strings.cpp:276
msgid "Reports the line of the current navigator object where the review cursor is situated. If this key is pressed twice, the current line will be spelled. Pressing three times will spell the line using character descriptions."
msgstr "Prijavljuje red trenutnog navigacionog objekta gde se nalazi pregledni kursor. Ako se taster dva puta pritisne, sriče  trenutni red. Ako se pritisne tri puta sriče red koristeći opise karaktera."

#: src/i18n/data_strings.cpp:277
msgid "Reports the symbol where the review cursor is positioned. Pressed twice, shows the symbol and the text used to speak it in browse mode"
msgstr "Prijavljuje simbol na trenutnoj poziciji preglednog kursora. Ako se pritisne 2 puta, prikazuje simbol kao i tekst koji se izgovara u režimu pretraživanja"

#: src/i18n/data_strings.cpp:278
msgid "Speaks the word of the current navigator object where the review cursor is situated. Pressing twice spells the word. Pressing three times spells the word using character descriptions"
msgstr "Izgovara reč trenutnog navigacionog objekta gde se nalazi pregledni kursor. Ako se taster pritisne dva puta, reč se sriče. Ako se pritisne tri puta reč se sriče koristeći opise znakova"

#: src/i18n/data_strings.cpp:279
msgid "Moves the review cursor to the last character of the line where it is situated in the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na poslednji znak reda gde je smešten u trenutnom navigacionom objektu i izgovara ga"

#: src/i18n/data_strings.cpp:280
msgid "Moves the review cursor to the last character of the selection, and speaks it"
msgstr "Pomera pregledni kursor na poslednji znak izbora i izgovara ga"

#: src/i18n/data_strings.cpp:281
msgid "Marks the current position of the review cursor as the start of text to be selected or copied"
msgstr "Označava trenutnu poziciju preglednog kursora kao početak teksta koji treba da se Izabere ili kopira"

#: src/i18n/data_strings.cpp:282
msgid "Move the review cursor to the position marked as the start of text to be selected or copied"
msgstr "Premešta pregledni kursor na poziciju koja je označena kao početak teksta za izbor ili kopiranje"

#: src/i18n/data_strings.cpp:283
msgid "Moves the review cursor to the next character of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na naredni znak u trenutnom navigacionom objektu i izgovara ga"

#: src/i18n/data_strings.cpp:284
msgid "Moves the review cursor to the next line of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor u naredni red trenutnog navigacionog objekta i izgovara ga"

#: src/i18n/data_strings.cpp:285
msgid "Moves the review cursor to the next page of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na narednu stranicu trenutnog navigacionog objekta i izgovara je"

#: src/i18n/data_strings.cpp:286
msgid "Moves the review cursor to the next word of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na narednu reč trenutnog navigacionog objekta i izgovara je"

#: src/i18n/data_strings.cpp:287
msgid "Moves the review cursor to the previous character of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na prethodni znak u trenutnom navigacionom objektu i izgovara ga"

#: src/i18n/data_strings.cpp:288
msgid "Moves the review cursor to the previous line of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor u prethodni red trenutnog navigacionog objekta i izgovara ga"

#: src/i18n/data_strings.cpp:289
msgid "Moves the review cursor to the previous page of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na prethodnu stranicu trenutnog navigacionog objekta i izgovara je"

#: src/i18n/data_strings.cpp:290
msgid "Moves the review cursor to the previous word of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na prethodnu reč trenutnog navigacionog objekta i izgovara je"

#: src/i18n/data_strings.cpp:291
msgid "Reads from the review cursor up to the end of the current text, moving the review cursor as it goes"
msgstr "Čita od pozicije preglednog kursora do kraja trenutnog teksta, pomerajući kursor sa sobom"

#: src/i18n/data_strings.cpp:292
msgid "Moves the review cursor to the first character of the line where it is situated in the current navigator object and speaks it"
msgstr "Pomera pregledni kursor na prvi znak reda gde je smešten u trenutnom navigacionom objektu i izgovara ga"

#: src/i18n/data_strings.cpp:293
msgid "Moves the review cursor to the first character of the selection, and speaks it"
msgstr "Pomera pregledni kursor na prvi znak izbora i izgovara ga"

#: src/i18n/data_strings.cpp:294
msgid "Moves the review cursor to the top line of the current navigator object and speaks it"
msgstr "Pomera pregledni kursor u prvi red trenutnog navigacionog objekta i izgovara ga"

#: src/i18n/data_strings.cpp:295
msgid "Clicks the right mouse button once at the current mouse position"
msgstr "Izvršava jedan klik desnog dugmeta miša na trenutnoj poziciji miša"

#: src/i18n/data_strings.cpp:296
msgid "Saves the current ALUS configuration"
msgstr "Čuva trenutna ALUS podešavanja"

#: src/i18n/data_strings.cpp:297
msgid "Reads from the system caret up to the end of the text, moving the caret as it goes"
msgstr "Čita od sistemskog kursora do kraja teksta, pomerajući kursor sa sobom"

#: src/i18n/data_strings.cpp:298
msgid "Reports battery status and time remaining if AC is not plugged in"
msgstr "Obaveštava o statusu baterije i preostalom vremenu ako punjač nije povezan"

#: src/i18n/data_strings.cpp:299
msgid "Presents, in browse mode, formatting info for the text under the caret."
msgstr "Prikazuje, u režimu pretraživanja, informacije o formatiranju teksta na trenutnoj poziciji kursora."

#: src/i18n/data_strings.cpp:300
msgid "Presents, in browse mode, formatting info for the current review cursor position."
msgstr "Prikazuje, u režimu pretraživanja, informacije o  formatiranju za trenutnu poziciju preglednog kursora."

#: src/i18n/data_strings.cpp:301
msgid "Shows the ALUS menu"
msgstr "Prikazuje ALUS meni"

#: src/i18n/data_strings.cpp:302
msgid "Reads all controls in the active window"
msgstr "Čita sve kontrole u aktivnom prozoru"

#: src/i18n/data_strings.cpp:303
msgid "Cycles between speech modes."
msgstr "Kruži kroz režime govora."

#: src/i18n/data_strings.cpp:304
msgid "Cycle through the speech Unicode normalization states"
msgstr "Kruži kroz stanja unikodne standardizacije izgovora"

#: src/i18n/data_strings.cpp:305
msgid "Spells the current application status bar."
msgstr "Sriče statusnu traku trenutne aplikacije."

#: src/i18n/data_strings.cpp:306
msgid "Opens the WX GUI inspection tool. Used to get more information about the state of GUI components."
msgstr "Otvara WX GUI inspection alatku. Koristi se za dobijanje dodatnih informacija o GUI komponentama."

#: src/i18n/data_strings.cpp:307
msgid "Reports the title of the current application or foreground window. If pressed twice, spells the title. If pressed three times, copies the title to the clipboard"
msgstr "Prikazuje naslov trenutne aplikacije ili vidljivog prozora. Ako se pritisne dva puta, sriče naslov. Ako se pritisne tri puta, kopira naslov u privremenu memoriju"

#: src/i18n/data_strings.cpp:308
msgid "Toggles braille automatic scroll"
msgstr "Uključuje ili isključuje automatsko pomeranje brajevog reda"

#: src/i18n/data_strings.cpp:309
msgid "Toggles braille mode"
msgstr "Menja brajev režim"

#: src/i18n/data_strings.cpp:310
msgid "Toggles on and off the movement of the review cursor due to the caret moving."
msgstr "Uključuje i isključuje pomeranje preglednog kursora sistemskim kursorom."

#: src/i18n/data_strings.cpp:311
msgid "Toggles disabling of all configuration profile triggers. Disabling remains in effect until ALUS is restarted"
msgstr "Uključuje i isključuje deaktiviranje aktivatora profila podešavanja. Oni ostaju deaktivirani dok se ALUS ponovo ne pokrene"

#: src/i18n/data_strings.cpp:312
msgid "Toggles sleep mode on and off for the active application."
msgstr "Uključuje i isključuje režim spavanja za trenutnu aplikaciju."

#: src/i18n/data_strings.cpp:313
msgid "Toggles on and off delayed descriptions for characters on cursor movement"
msgstr "Uključuje i isključuje odložene opise znakova pri pomeranju kursora"

#: src/i18n/data_strings.cpp:314
msgid "Toggles on and off the movement of the navigator object due to focus changes"
msgstr "Uključuje i isključuje kretanje navigacionog objekta tokom promena fokusa"

#: src/i18n/data_strings.cpp:315
msgid "Turns input help on or off. When on, any input such as pressing a key on the keyboard will tell you what script is associated with that input, if any."
msgstr "Uključuje i isključuje pomoć za unos. Kada je uključena, svaki unos, poput pritiskanja tastera će vam reći koja skripta je povezana sa tim unosom, ako je neka povezana."

#: src/i18n/data_strings.cpp:316
msgid "Toggles between desktop and laptop keyboard layout"
msgstr "Prebacuje se između desktop i laptop rasporeda tastature"

#: src/i18n/data_strings.cpp:317
msgid "Locks or unlocks the left mouse button"
msgstr "Zaključava ili otključava levo dugme miša"

#: src/i18n/data_strings.cpp:318
msgid "Toggles beeps that report mouse coordinates as the mouse moves"
msgstr "Uključuje ili isključuje zvučne signale koji prikazuju koordinate miša dok se pomera"

#: src/i18n/data_strings.cpp:319
msgid "Toggles how much text will be spoken when the mouse moves"
msgstr "Menja koliko će teksta biti pročitano dok se miš pomera"

#: src/i18n/data_strings.cpp:320
msgid "Toggles the reporting of information as the mouse moves"
msgstr "Uključuje ili isključuje prijavljivanje informacija dok se miš pomera"

#: src/i18n/data_strings.cpp:321
msgid "Toggles between beeps, speech, beeps and speech, and off, for reporting progress bar updates"
msgstr "Kruži kroz režime pištanja, izgovora, izgovora i pištanja i isključeno za obaveštenja o promenama traka napredovanja"

#: src/i18n/data_strings.cpp:322
msgid "Toggles on and off the reporting of text alignment"
msgstr "Uključuje i isključuje prijavljivanje poravnanja teksta"

#: src/i18n/data_strings.cpp:323
msgid "Toggles on and off the reporting of articles"
msgstr "Uključuje i isključuje prijavljivanje članaka"

#: src/i18n/data_strings.cpp:324
msgid "Toggles on and off the reporting of block quotes"
msgstr "Uključuje i isključuje prijavljivanje citata"

#: src/i18n/data_strings.cpp:325
msgid "Toggles on and off the reporting of CLDR characters, such as emojis"
msgstr "Uključuje i isključuje prijavljivanje CLDR znakova, kao što su emodži"

#: src/i18n/data_strings.cpp:326
msgid "Cycles through the cell border reporting settings"
msgstr "Kruži kroz podešavanja za prijavljivanje granica ćelija"

#: src/i18n/data_strings.cpp:327
msgid "Toggles on and off reporting if clickable"
msgstr "Uključuje i isključuje prijavljivanje klikabilnosti"

#: src/i18n/data_strings.cpp:328
msgid "Toggles on and off the reporting of colors"
msgstr "Uključuje i isključuje prijavljivanje boja"

#: src/i18n/data_strings.cpp:329
msgid "Toggles on and off the reporting of comments"
msgstr "Uključuje i isključuje prijavljivanje komentara"

#: src/i18n/data_strings.cpp:330
msgid "Toggles on and off the reporting of dynamic content changes, such as new text in dos console windows"
msgstr "Uključuje i isključuje prijavljivanje dinamičkih promena sadržaja, kao što je nov tekst u prozoru DOS konzole"

#: src/i18n/data_strings.cpp:331
