#. Translators: spoken when alus+numpad slash finds nothing the
#. navigator object can do when clicked.
#: src/a11y/commands.cpp:133 src/a11y/commands.cpp:137
msgid "cannot click this object"
msgstr ""

#. Translators: Reported when left mouse button is clicked.
#: src/a11y/commands.cpp:141
msgid "Left click"
msgstr ""

#. Translators: spoken when alus+numpad star cannot open a context
#. menu for the navigator object; shift+F10 or the menu key opens it
#. from the keyboard in most applications.
#: src/a11y/commands.cpp:157
msgid "no context menu for this object; try shift+F10 or the menu key"
msgstr ""

#. Translators: Reported when right mouse button is clicked.
#: src/a11y/commands.cpp:161
msgid "Right click"
msgstr ""

#. Translators: the user asked about the navigator object and there is
#. none.
#. Translators: reported when there is nothing under the cursor to ask
#. about.
#: src/a11y/commands.cpp:169 src/a11y/commands.cpp:603
msgid "No navigator object"
msgstr ""

#. Translators: there is no focused object.
#: src/a11y/commands.cpp:194 src/a11y/commands.cpp:306
#: src/a11y/commands.cpp:310 src/nav/text_commands.cpp:568
#: src/nav/text_commands.cpp:599 src/nav/text_commands.cpp:624
#: src/nav/text_commands.cpp:646 src/nav/text_commands.cpp:698
#: src/nav/text_commands.cpp:793
msgid "No focus"
msgstr ""

#. Translators: there is no object containing this one.
#: src/a11y/commands.cpp:227
msgid "No containing object"
msgstr ""

#. Translators: there is nothing inside this object.
#: src/a11y/commands.cpp:236
msgid "No objects inside"
msgstr ""

#. Translators: this is the last object.
#: src/a11y/commands.cpp:245
msgid "No next"
msgstr ""

#. Translators: this is the first object.
#: src/a11y/commands.cpp:254
msgid "No previous"
msgstr ""

#. Translators: the review cursor was moved to the object with focus.
#: src/a11y/commands.cpp:314
msgid "Move to focus"
msgstr ""

#. Translators: the keyboard focus was moved to the navigator object.
#: src/a11y/commands.cpp:326
msgid "Move focus"
msgstr ""

#. Translators: the object could not take the keyboard focus.
#: src/a11y/commands.cpp:331
msgid "Cannot focus this object"
msgstr ""

#. Translators: the object has no position on the screen.
#. Translators: the caret has no position on the screen -- a terminal
#. that reports no geometry, or a control scrolled out of view.
#: src/a11y/commands.cpp:343 src/nav/text_commands.cpp:659
#: src/nav/text_commands.cpp:666
msgid "No location information"
msgstr ""

#. Translators: the action at the navigator object was
#. performed. The toolkit's own word for it is used when it has
#. one ("click", "press"), and "Activate" otherwise.
#: src/a11y/commands.cpp:368
msgid "Activate"
msgstr ""

#. Translators: nothing at the navigator object could be activated.
#: src/a11y/commands.cpp:375
msgid "No action"
msgstr ""

#. Translators: the active window has no title.
#: src/a11y/commands.cpp:386
msgid "No title"
msgstr ""

#. Translators: reported when the review cursor is set to follow
#. the system caret (alus+6).
#: src/a11y/commands.cpp:422
msgid "caret moves review cursor on"
msgstr ""

#. Translators: reported when the review cursor no longer follows
#. the system caret.
#: src/a11y/commands.cpp:425
msgid "caret moves review cursor off"
msgstr ""

#. Translators: reported when the navigator object is set to
#. follow the focus (alus+7).
#: src/a11y/commands.cpp:437
msgid "focus moves navigator object on"
msgstr ""

#. Translators: reported when the navigator object no longer
#. follows the focus.
#: src/a11y/commands.cpp:440
msgid "focus moves navigator object off"
msgstr ""

#. Translators: reported when text that changes by itself -- a
#. terminal, a chat window, a log -- is announced again (alus+5).
#: src/a11y/commands.cpp:453
msgid "report dynamic content changes on"
msgstr ""

#. Translators: reported when text that changes by itself is no
#. longer announced.
#: src/a11y/commands.cpp:456
msgid "report dynamic content changes off"
msgstr ""

#. Translators: a progress bar reporting mode (alus+u): nothing is
#. reported.
#: src/a11y/commands.cpp:470
msgid "No progress bar updates"
msgstr ""

#. Translators: a progress bar reporting mode: the percentage is
#. spoken.
#: src/a11y/commands.cpp:476
msgid "Speak progress bar updates"
msgstr ""

#. Translators: a progress bar reporting mode: a beep that rises
#. in pitch as the bar fills.
#: src/a11y/commands.cpp:482
msgid "Beep for progress bar updates"
msgstr ""

#. Translators: a progress bar reporting mode: both the beep and
#. the spoken percentage.
#: src/a11y/commands.cpp:488
msgid "Beep and speak progress bar updates"
msgstr ""

#. Translators: reported when the focused control has no keyboard
#. shortcut of its own (shift+numpad2).
#: src/a11y/commands.cpp:508
msgid "No shortcut key"
msgstr ""

#. Translators: reported when the focused control points at no
#. additional details (alus+d).
#: src/a11y/commands.cpp:530
msgid "No additional details"
msgstr ""

#. Translators: reported when the details a control points at exist
#. but carry no readable text.
#: src/a11y/commands.cpp:561
msgid "No details summary"
msgstr ""

#. Translators: reported when the developer information about an object has
#. been written to the log (alus+f1).
#: src/a11y/commands.cpp:585
msgid "Developer info written to the log"
msgstr ""

#. Translators: reported when the thing under the cursor is a link but
#. the application does not say where it points.
#: src/a11y/commands.cpp:616
msgid "Link has no apparent destination"
msgstr ""

#. Translators: reported when the thing under the cursor is not a link at
#. all (alus+k).
#: src/a11y/commands.cpp:621
msgid "Not a link."
msgstr ""

#. Translators: "3 rows", part of "with 3 rows and 2 columns".
#: src/a11y/object_speech.cpp:44
#, c-format
msgid "%s row"
msgid_plural "%s rows"
msgstr[0] ""
msgstr[1] ""

#. Translators: "2 columns", part of "with 3 rows and 2 columns".
#: src/a11y/object_speech.cpp:49
#, c-format
msgid "%s column"
msgid_plural "%s columns"
msgstr[0] ""
msgstr[1] ""

#. Translators: the compound form, e.g. "with 3 rows and 2 columns";
#. the first %s is the row count and the second the column count.
#: src/a11y/object_speech.cpp:60
#, c-format
msgid "with %s and %s"
msgstr ""

#. Translators: a table's size when only the column count is known,
#. e.g. "with 2 columns".
#. Translators: a table's size when only the row count is known.
#: src/a11y/object_speech.cpp:66 src/a11y/object_speech.cpp:70
#, c-format
msgid "with %s"
msgstr ""

#. Translators: a state of an object is negated; %s is the state's own
#. label (e.g. "selected"). NVDA keeps separate strings for the states that
#. are commonly negated and falls back to this one for the rest.
#: src/a11y/object_speech.cpp:216
#, c-format
msgid "not %s"
msgstr ""

#. Translators: the current row number, e.g. "row 3".
#: src/a11y/object_speech.cpp:342
#, c-format
msgid "row %s"
msgstr ""

#. Translators: the row span, e.g. "through 5".
#: src/a11y/object_speech.cpp:345 src/a11y/object_speech.cpp:361
#, c-format
msgid "through %s"
msgstr ""

#. Translators: the current column number, e.g. "column 3".
#: src/a11y/object_speech.cpp:357
#, c-format
msgid "column %s"
msgstr ""

#: src/a11y/object_speech.cpp:371
#, c-format
msgid "through row %s column %s"
msgstr ""

#. Translators: there are further details that can be fetched.
#: src/a11y/object_speech.cpp:394
msgid "has details"
msgstr ""

#. Translators: "has comment", "has suggestion"; %s is the kind
#. of detail.
#. Translators: brailled when there are details of a known kind; %s is
#. the abbreviation of the kind, e.g. "cmnt".
#: src/a11y/object_speech.cpp:399 src/braille/properties.cpp:75
#, c-format
msgid "has %s"
msgstr ""

#. Translators: the position of an item in a group; the first %s is
#. the item's number and the second how many there are, e.g. "3 of 7".
#. Translators: the position of an item in a group, brailled; the
#. first %s is the item's number and the second how many there are, so
#. the result reads "3 of 7".
#: src/a11y/object_speech.cpp:411 src/braille/properties.cpp:181
#, c-format
msgid "%s of %s"
msgstr ""

#. Translators: the item level in a tree, e.g. "level 2".
#: src/a11y/object_speech.cpp:416
#, c-format
msgid "level %s"
msgstr ""

#: src/a11y/object_speech.cpp:864
#, c-format
msgid "%s percent"
msgstr ""

